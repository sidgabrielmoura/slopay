# Use dev em desenvolvimento e producao no frontend e no backend de produção.
AMBIENTE=dev

# Backend consultado exclusivamente pelo servidor Next.js.
# Em produção, preencha as duas origens com URLs HTTPS sem caminho.
# Use SLOPAY_APP_ORIGIN=https://app.slopay.com.br no frontend publicado.
SLOPAY_BACKEND_URL=http://127.0.0.1:3333
SLOPAY_APP_ORIGIN=http://localhost:3000
# Cabeçalho de IP único escrito pelo ingress público. Configure só com o ingress
# sobrescrevendo o valor e o backend confiando apenas no proxy via TRUSTED_PROXY_CIDRS.
SLOPAY_TRUSTED_CLIENT_IP_HEADER=

# Use 1 para carregar as rotas de demonstração em next dev.
# O build e o servidor de produção sempre carregam as rotas de operação.
SLOPAY_DEMO_MODE=0

# Em next dev, exibe as telas simuladas do superadmin após autenticação real.
SLOPAY_SUPERADMIN_PREVIEW=0

# DSN público. A Vercel usa o projeto SloPay por padrão somente em Production.
# Deixe vazio no desenvolvimento ou defina um DSN para testar a ingestão.
NEXT_PUBLIC_SENTRY_DSN=
# Token de CI opcional para envio privado de mapas de código-fonte durante o build.
SENTRY_AUTH_TOKEN=
